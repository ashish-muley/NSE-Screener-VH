# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values for live mode.
# `.env` is git-ignored. NEVER commit real credentials.
# ---------------------------------------------------------------------------

# mock = fully offline synthetic data (no credentials needed, this is the default)
# live = connect to Angel One SmartAPI using the credentials below
MODE=mock

# --- Angel One SmartAPI credentials (only needed when MODE=live) ------------

# !! THIS FILE IS COMMITTED TO GIT. Placeholders only — never real values. !!
# !! Put real credentials in `.env` (git-ignored), never here.             !!

# API key of a "Market Feeds" / trading app created at https://smartapi.angelbroking.com/
ANGEL_API_KEY=your_api_key_here

# Your Angel One client code, e.g. A123456
ANGEL_CLIENT_CODE=your_client_code_here

# The 4-digit / 6-digit MPIN you use to log in (NOT your web password)
ANGEL_MPIN=your_mpin_here

# The base32 TOTP secret shown when you enable 2FA (the string behind the QR code).
# The app generates a fresh 6-digit code from this with pyotp at login time.
ANGEL_TOTP_SECRET=your_totp_base32_secret_here

# --- Optional overrides -----------------------------------------------------

# Override the config.yaml server bind address / port
# HOST=127.0.0.1
# PORT=8000

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
